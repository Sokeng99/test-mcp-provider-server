# MCP Teams Server Configuration
# Copy this file to .env and fill in your values

# API Key for MCP server authentication
MCP_API_KEY=langflow-teams-secret-123456

# === For Graph API Approach (Recommended - FREE!) ===
# Power Automate Flow URL (from Flow 1 - Send TO Teams)
# Get this from: Power Automate → Your flow → HTTP trigger → HTTP POST URL
POWER_AUTOMATE_SEND_URL=https://prod-XX.eastus.logic.azure.com:443/workflows/.../invoke?api-version=...

# Microsoft Teams IDs
# Get these from Teams URL or Graph Explorer (see POWER_AUTOMATE_SETUP.md)
TEAMS_TEAM_ID=your-team-id-here
TEAMS_CHANNEL_ID=your-channel-id-here

# === For Incoming Webhook Approach (Alternative - One-way only) ===
# Get this URL from Teams → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=https://your-power-automate-webhook-url-here

# === For Outgoing Webhook Approach (If available) ===
# Security token from Teams Outgoing Webhook setup
TEAMS_SECURITY_TOKEN=
