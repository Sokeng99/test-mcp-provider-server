{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "2f1bd833-b2e7-48be-9075-b13623cc9165",
  "packageName": "com.xpilot.bot",
  "developer": {
    "name": "X-pilot Team",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "X-pilot Bot",
    "full": "X-pilot AI Assistant powered by Langflow"
  },
  "description": {
    "short": "AI assistant for your team",
    "full": "X-pilot is an intelligent AI assistant powered by Langflow that helps you with information, answers questions, and assists with various tasks. Simply chat with the bot to get started!"
  },
  "accentColor": "#4A90E2",
  "bots": [
    {
      "botId": "2f1bd833-b2e7-48be-9075-b13623cc9165",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": [
            "personal",
            "team",
            "groupchat"
          ],
          "commands": [
            {
              "title": "help",
              "description": "Get help on how to use this bot"
            }
          ]
        }
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": []
}
